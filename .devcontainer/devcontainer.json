{
  // "Open in GitHub Codespaces": a ready Python environment in the browser.
  // Everything runs inside the visitor's own codespace; nothing is exposed.
  // Then run:  python scripts/demo.py
  "name": "ATLAS",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "echo 'ATLAS is ready. Run: python scripts/demo.py'",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
